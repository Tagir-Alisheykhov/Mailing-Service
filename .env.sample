# 1. Скопируйте данный файл
# 2. Переименуйте файл на `.env`
# 3. Подставьте необходимые ключи.

[ Secret Keys ]
DJANGO_SECRET_KEY = your_secret_key

[ Utils ]
DEBUG = your_choice

[ Database settings ]
DB_NAME = db_name
DB_USER = db_username
DB_PASSWORD = db_password
DB_HOST = db_hostname
DB_PORT = db_port

[ Email backend
EMAIL_HOST = your_host (EXAMPLE smtp.yandex.ru)
EMAIL_PORT = your_port (EXAMPLE 465)
EMAIL_HOST_USER = your_post_adress (EXAMPLE my@yandex.ru)
EMAIL_HOST_PASSWORD = your_email_token
